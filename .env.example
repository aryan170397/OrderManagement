# Copy to .env in the repository root. The API loads this file explicitly at startup.
# Existing environment variables are not overwritten. Do not commit .env.

ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=ordermanagement;User ID=ordermanagement;Password=CHANGE_ME;SslMode=Preferred;CharSet=utf8mb4
Jwt__Issuer=OrderManagement
Jwt__Audience=OrderManagement.Api
Jwt__SigningKey=CHANGE_ME_TO_A_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
Jwt__ExpirationMinutes=60
AdminSeed__ApplyOnStartup=true
AdminSeed__Email=admin@example.com
AdminSeed__Password=CHANGE_ME_ADMIN_PASSWORD
AdminSeed__Name=Administrator
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# Integration tests. Point this at a MySQL server, not a database you need to keep.
# The tests create and drop their own database.
# ORDERMANAGEMENT_TEST_CONNECTION=Server=127.0.0.1;Port=3306;User ID=root;Password=CHANGE_ME;SslMode=Disabled
